{
  "name": "seed-shape",
  "version": "0.1.0",
  "description": "Generate reviewable seed-data plans and deterministic fixtures from small schema sources.",
  "type": "module",
  "bin": {
    "seed-shape": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.zh-CN.md",
    "SECURITY.md",
    "SECURITY.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "seed",
    "fixtures",
    "schema",
    "prisma",
    "sql",
    "test-data"
  ],
  "author": "maxi-maxima",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^24.0.1",
    "eslint": "^9.29.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.3"
  }
}
